{
  "name": "innovatiview-india-ltd",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "seed": "npm run seed -w backend",
    "seed:demo": "npm run seed:demo -w backend",
    "test": "npm run test -w backend",
    "test:unit": "npm run test:unit -w backend",
    "test:integration": "npm run test:integration -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
